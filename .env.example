# Runtime config for the image (in Kubernetes: a Secret). cp .env.example .env and fill in.
# See README.md, "Env vars".

# The host name people open in the browser
SITE_NAME=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# CA file for SSL to the database (mounted into the container). Empty = no SSL.
DB_SSL_CA=

# redis://default:<password>@<host>:<port>, or rediss://... for TLS
REDIS_URL=

# Generate once, never change:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Only used on the first start (empty database)
ADMIN_PASSWORD=

# 1 = run migrate on every start. Only for an environment with a database of its own.
AUTO_MIGRATE=0

# Optional
# HOST_NAME=https://<SITE_NAME>
# INSTALL_APPS=telephony helpdesk crm insurance
# GUNICORN_WORKERS=2
# Local dev only, never in prod:
# DEVELOPER_MODE=1
# SERVER_SCRIPT_ENABLED=1
